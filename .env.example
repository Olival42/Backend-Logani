# Environment: dev or prod
ENV=dev

# Django
SECRET_KEY='your-super-secret-key-here'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Web App Port
PORT=8000

# PostgreSQL Database
POSTGRES_DB=api_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# User Auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login
MAX_LOGIN_ATTEMPTS=5 
LOCK_TIME_SECONDS=300

# Asaas API Configuration
ASAAS_API_TOKEN='seu-token-asaas-aqui'
ASAAS_API_URL=https://api-sandbox.asaas.com/v3 #por padrão
ASAAS_ENVIRONMENT=sandbox #por padrão
ASAAS_WALLET_ID=<id-da-sua-carteira-do-asaas>

# Ngrok Token
NGROK_AUTHTOKEN=seu-token-ngrok-aqui #para testes

# Order Configuration
DAYS_TO_CANCEL=2

# Send Email Configuration
OWNER_EMAIL=seu-email@exemplo.com
DEFAULT_FROM_EMAIL=noreply@api-pagamento.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@exemplo.com
EMAIL_HOST_PASSWORD=sua-senha-app